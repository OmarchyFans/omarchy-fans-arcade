#!/bin/bash
#
# arcade — launch Arcade games.
#
#   arcade play <game>                    a built-in game (games/<id>/), nothing else needed
#   arcade play pacman|galaga|ssf2        a MAME game, from your own ROM files
#   arcade list                           what is ready to play, and what is missing
#   arcade rom-dir [--open]               print (and create) the ROM folder; --open shows it
#   arcade install-mame [--then GAME]     install MAME now (then start GAME)
#   arcade help                           this text
#   arcade update-check|update-dismiss|update-run ...   see lib/update.sh
#
# MAME installs itself the first time you pick a MAME game: Arcade opens a terminal
# that runs Omarchy's own `omarchy-pkg-add mame` (your password may be asked), then
# starts the game. Arcade never downloads, links to, or ships ROMs: put your own ROM
# zips in ~/Games/arcade, or set "rom_dir" in ~/.config/omarchy-arcade/config.json.
#
# Every tool is an absolute path or comes from root-owned system folders, never the
# caller's PATH. The ARCADE_* variables exist for the test suite.
set -euo pipefail
export PATH="/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin"

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ARCADE_DIR="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-arcade/config.json"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
MAME="${ARCADE_MAME:-/usr/bin/mame}"
QUICKSHELL="${ARCADE_QUICKSHELL:-/usr/bin/quickshell}"
NOTIFY="${ARCADE_NOTIFY:-/usr/bin/notify-send}"
PKG_ADD="${ARCADE_PKG_ADD:-/usr/bin/omarchy-pkg-add}"
LAUNCH_TUI="${ARCADE_LAUNCH_TUI:-/usr/bin/omarchy-launch-tui}"
OPEN="${ARCADE_OPEN:-/usr/bin/xdg-open}"

MAME_GAMES=(pacman galaga ssf2)

# Built-in games are discovered, not listed here: every games/<id>/game.json with
# a shell.qml next to it, in "order". An id is lowercase letters, digits and
# dashes, and matches its folder. See docs/GAMES.md.
builtin_ids() {
  local f id dir
  for f in "$ARCADE_DIR"/games/*/game.json; do
    [[ -f $f ]] || continue
    dir=$(basename "$(dirname "$f")")
    id=$(jq -r '.id // empty' "$f" 2>/dev/null) || continue
    [[ $id =~ ^[a-z0-9-]+$ && $id == "$dir" && -f $ARCADE_DIR/games/$id/shell.qml ]] || continue
    printf '%s\t%s\n' "$(jq -r '.order // 100' "$f")" "$id"
  done | sort -n -k1,1 | cut -f2
}
is_builtin() { [[ $1 =~ ^[a-z0-9-]+$ ]] && builtin_ids | grep -qx -- "$1"; }
is_mame() { local g; for g in "${MAME_GAMES[@]}"; do [[ $g == "$1" ]] && return 0; done; return 1; }
all_games() { builtin_ids; printf '%s\n' "${MAME_GAMES[@]}"; }
builtin_field() { jq -r --arg k "$2" '.[$k] // empty' "$ARCADE_DIR/games/$1/game.json" 2>/dev/null; }

game_title() {
  if is_mame "$1"; then :; elif is_builtin "$1"; then builtin_field "$1" title; return; fi
  case "$1" in
    pacman) echo "Pac-Man" ;;
    galaga) echo "Galaga" ;;
    ssf2)   echo "Super Street Fighter II" ;;
    *)      return 1 ;;
  esac
}

# Zip names that can hold the game. MAME's pacman (Midway) is a clone of puckman
# (Namco): a merged set keeps it inside puckman.zip.
game_zips() {
  case "$1" in
    pacman) echo "pacman puckman" ;;
    *)      echo "$1" ;;
  esac
}

# What else MAME may need next to the game zip. Merged and non-merged sets
# already contain it; split sets do not. -verifyroms has the final word.
game_extras() {
  case "$1" in
    pacman) echo "puckman.zip" ;;
    galaga) echo "namco51.zip namco54.zip" ;;
    ssf2)   echo "qsound.zip" ;;
    *)      echo "" ;;
  esac
}

have_rom() { # have_rom ID DIR — is any zip (or folder) that can hold the game there?
  local z
  for z in $(game_zips "$1"); do
    [[ -f $2/$z.zip || -d $2/$z ]] && return 0
  done
  return 1
}

mame_version() { "$MAME" -version 2>/dev/null | head -n1 | cut -d' ' -f1; }

say() { # say TITLE BODY — a desktop notification, and the same text on stderr
  printf '%s: %s\n' "$1" "$2" >&2
  [[ -x $NOTIFY ]] && "$NOTIFY" -a Arcade -i applications-games "$1" "$2" 2>/dev/null || true
}

rom_dir() {
  local d=""
  if [[ -f $CONFIG ]]; then
    d=$(jq -r '.rom_dir // empty | strings' "$CONFIG" 2>/dev/null || true)
  fi
  [[ -n $d ]] || d="$HOME/Games/arcade"
  # shellcheck disable=SC2088  # a literal "~" from the JSON file, expanded by hand
  [[ $d == "~" || $d == "~/"* ]] && d="$HOME${d:1}"
  # A relative path means relative to home; MAME later runs from another folder.
  [[ $d == /* ]] || d="$HOME/$d"
  printf '%s\n' "$d"
}

# A built-in game runs as its own Quickshell process, one instance at a time.
play_builtin() {
  local id=$1 title
  title=$(game_title "$id")
  [[ -x $QUICKSHELL ]] || { say "$title" "Quickshell is missing ($QUICKSHELL). It ships with Omarchy; reinstall the omarchy-shell package."; return 1; }
  mkdir -p "$STATE"
  exec "$QUICKSHELL" -n -p "$ARCADE_DIR/games/$id/shell.qml"
}

# Is someone at a terminal to answer a password prompt? ARCADE_INTERACTIVE=0|1
# overrides the check for the test suite.
interactive() {
  case "${ARCADE_INTERACTIVE:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [[ -t 0 && -t 1 ]]
}

open_folder() { # show a folder in the file manager, without waiting for it
  setsid -f "$OPEN" "$1" >/dev/null 2>&1 </dev/null || true
}

hold() { # keep a terminal Arcade opened on screen until the message is read
  interactive && read -rp "$1 Press Enter to close " _ || true
}

# Install MAME from the official Arch repositories with Omarchy's own helper,
# which asks for the password itself. Returns non-zero if MAME is still missing.
install_mame() {
  if [[ -x $MAME ]]; then
    echo "MAME is already installed ($(mame_version))."
    return 0
  fi
  echo "Arcade is installing MAME, the arcade emulator, from the official Arch"
  echo "repositories (about 460 MiB). Your password may be asked for."
  echo
  if ! "$PKG_ADD" mame || [[ ! -x $MAME ]]; then
    echo
    echo "MAME did not install. Try again any time with: arcade install-mame"
    return 1
  fi
  echo
  echo "MAME $(mame_version) is installed."
}

cmd_install_mame() {
  local then="" keep=1
  while (( $# )); do
    case "$1" in
      --then) then=${2:-}; shift ;;
      --no-hold) keep=0 ;;               # a caller (install.sh) carries on by itself
    esac
    shift
  done
  if [[ -n $then ]] && ! game_title "$then" >/dev/null; then
    echo "arcade: unknown game '$then'" >&2; return 2
  fi
  if ! install_mame; then
    (( keep )) && hold "Nothing was started."
    return 1
  fi
  [[ -n $then ]] || return 0
  # Start the game on its own, so this terminal can close; if a ROM is missing,
  # the game's notification says which one.
  echo "Starting $(game_title "$then")…"
  setsid -f /usr/bin/bash "$SELF" play "$then" >/dev/null 2>&1 </dev/null
  sleep 1
}

play_mame() {
  local id=$1 title dir out bad
  title=$(game_title "$id")
  if [[ ! -x $MAME ]]; then
    if interactive; then
      install_mame || return 3
    elif [[ -x $LAUNCH_TUI ]]; then
      # Picked from the bar: install in a terminal, where the password can be typed.
      setsid -f "$LAUNCH_TUI" --app-id=TUI.float /usr/bin/bash "$SELF" install-mame --then "$id" >/dev/null 2>&1 </dev/null
      say "$title" "Installing MAME first, in the terminal that just opened. The game starts when it's done."
      return 0
    else
      say "$title needs MAME" "Open a terminal and run: arcade install-mame"
      return 3
    fi
  fi
  dir=$(rom_dir)
  # No ROM yet: from the bar, open the ROM folder (creating it) so the user
  # lands where the file goes; a notification alone is easy to miss.
  if [[ ! -d $dir ]]; then
    mkdir -p "$dir"
    interactive || open_folder "$dir"
    say "$title: add your ROM" "Arcade can't include $title. Put your own $id.zip in $dir (the folder just opened) and pick it again."
    return 4
  fi
  if ! have_rom "$id" "$dir"; then
    local extra; extra=$(game_extras "$id")
    interactive || open_folder "$dir"
    say "$title: add your ROM" "Arcade can't include $title. Put your own $id.zip in $dir${extra:+ (split sets also need: ${extra// /, })}, made for MAME $(mame_version), then pick it again."
    return 5
  fi
  # MAME checks every file against its own list: missing device ROMs, wrong
  # revisions and zips made for another MAME version all show up here.
  out=$("$MAME" -rompath "$dir" -verifyroms "$id" 2>&1 || true)
  if ! grep -Eq "^romset $id (\[[^]]*\] )?is (good|best available)" <<<"$out"; then
    bad=$(grep -E 'NOT FOUND|INCORRECT|NEEDS REDUMP' <<<"$out" | head -n 3 | sed 's/  */ /g' | paste -sd ';' - || true)
    say "$title: ROM check failed" "${bad:-MAME rejected $id.zip.} Your ROMs must match MAME $(mame_version)."
    return 6
  fi
  # MAME writes cfg/, nvram/ and friends into the working directory.
  mkdir -p "$STATE/mame"
  cd "$STATE/mame"
  exec "$MAME" -rompath "$dir" -skip_gameinfo "$id"
}

cmd_play() {
  local id=${1:-}
  if [[ -z $id ]]; then
    echo "usage: arcade play <$(all_games | paste -sd '|' -)>" >&2; return 2
  elif is_mame "$id"; then
    play_mame "$id"
  elif is_builtin "$id"; then
    play_builtin "$id"
  else
    echo "arcade: unknown game '$id' (try: arcade list)" >&2; return 2
  fi
}

# What each game needs. --json is what the bar menu reads:
#   [{id, title, kind: builtin|mame, state: ready|no-mame|no-rom|rom-found, note, genre}]
cmd_list() {
  local id dir state status note kind genre json=0 rows=()
  [[ ${1:-} == --json ]] && json=1
  dir=$(rom_dir)
  while IFS= read -r id; do
    kind=mame; genre=""
    if ! is_mame "$id"; then
      kind=builtin
      genre=$(builtin_field "$id" genre)
      note=$(builtin_field "$id" note); [[ -n $note ]] || note="built in"
      state=ready;     status="ready"
    elif [[ ! -x $MAME ]]; then
      state=no-mame;   status="MAME installs on first play";    note="installs MAME first"
    elif have_rom "$id" "$dir"; then
      state=rom-found; status="ROM found in $dir";              note="your ROM"
    else
      state=no-rom;    status="add your own $id.zip to $dir";   note="needs $id.zip"
    fi
    if (( json )); then
      rows+=("$(jq -nc --arg id "$id" --arg title "$(game_title "$id")" --arg kind "$kind" --arg state "$state" --arg note "$note" --arg genre "$genre" \
        '{id: $id, title: $title, kind: $kind, state: $state, note: $note, genre: $genre}')")
    else
      printf '%-10s %-26s %s\n' "$id" "$(game_title "$id")" "$status"
    fi
  done < <(all_games)
  (( json )) && printf '%s\n' "${rows[@]}" | jq -sc . || true
}

cmd_rom_dir() {
  local dir; dir=$(rom_dir)
  mkdir -p "$dir"
  printf '%s\n' "$dir"
  if [[ ${1:-} == --open ]]; then
    open_folder "$dir"
  fi
}

main() {
  case "${1:-help}" in
    play)           shift; cmd_play "$@" ;;
    list)           shift; cmd_list "$@" ;;
    rom-dir)        shift; cmd_rom_dir "$@" ;;
    install-mame)   shift; cmd_install_mame "$@" ;;
    update-check)   shift; exec /usr/bin/bash "$ARCADE_DIR/lib/update.sh" check "$@" ;;
    update-dismiss) shift; exec /usr/bin/bash "$ARCADE_DIR/lib/update.sh" dismiss "$@" ;;
    update-run)     shift; exec /usr/bin/bash "$ARCADE_DIR/lib/update.sh" run "$@" ;;
    help|-h|--help) sed -n '3,19p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *) echo "arcade: unknown command '$1' (try: arcade help)" >&2; return 2 ;;
  esac
}
main "$@"
